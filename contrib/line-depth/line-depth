#!/bin/sh
#
# Print the largest number of distinct commits in <rev-range> that touch any
# one line of <file> in the range <start>[,<end>] (or in all of it, with
# "max:<file>"), as "git log -L" tracks each line back from the tip of the
# range.
#
# Line numbers refer to <file> at the tip of <rev-range>.  Only lines that
# exist there are measured; deleted lines are not covered.
#
# All history tracking is done by "git log -L".  One run over a range of lines
# reports the commits touching any of them, which is an upper bound on the
# depth of each line in it, so a range that cannot beat the best depth found so
# far is skipped and the others are split in halves until single lines remain.
#
# Options: --fast measures only lines changed between the two ends of an X..Y
# range; --first-parent follows only first parents; --ignore-revs-file=<file>
# leaves the commits it lists out of every count.

usage="usage: line-depth [--fast] [--first-parent] [--ignore-revs-file=<file>]
                  <rev-range> <start>[,<end>]:<file>
   or: line-depth [options] <rev-range> max:<file>"

die () {
	echo "line-depth: $*" >&2
	exit 1
}

strategy=,sat,cap,group,
fast=
first_parent=
ignore_file=
while test $# -gt 0
do
	case $1 in
	--fast)
		fast=1
		;;
	--strategy=*)
		strategy=,${1#*=},
		;;
	--first-parent)
		first_parent=--first-parent
		;;
	--ignore-revs-file=*)
		ignore_file=${1#*=}
		;;
	-*)
		echo "$usage" >&2
		exit 129
		;;
	*)
		break
		;;
	esac
	shift
done

test $# = 2 || {
	echo "$usage" >&2
	exit 129
}

GIT_LITERAL_PATHSPECS=1
export GIT_LITERAL_PATHSPECS

range=$1
spec=$2
lines=${spec%%:*}
file=${spec#*:}
test "$lines" != "$spec" && test -n "$file" || die "bad range '$spec'
$usage"

tip=${range#*..}
tip=${tip#.}
tip=${tip:-HEAD}

if test -n "$fast"
then
	# Candidate lines come from the diff between the two ends, so the range
	# has to be a plain X..Y.
	case $range in
	*...*)
		die "--fast needs an X..Y range, not '$range'"
		;;
	*..*)
		left=${range%%..*}
		left=${left:-HEAD}
		;;
	*)
		die "--fast needs an X..Y range, not '$range'"
		;;
	esac
fi

# Also validates the revisions.  "git log -L" refuses a set that is empty
# because X and Y name the same commit, although the answer is simply 0.
count=$(git rev-list --count $first_parent "$range") || exit

# Commits to leave out of every count, one full object name per line, with
# "#" comments and blank lines allowed as in blame's ignore-revs files.
ignored=
if test -n "$ignore_file"
then
	ignored=$(sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' \
		"$ignore_file") || die "cannot read '$ignore_file'"
	if printf '%s\n' "$ignored" |
		grep -v -E '^([0-9a-f]{40}|[0-9a-f]{64})?$' >/dev/null
	then
		die "'$ignore_file' must list full object names"
	fi
fi

# Git already knows how many lines the file has at the tip: --numstat against
# the empty tree counts added lines (including an unterminated last one) and
# reports binary content as "-".
git cat-file -e "$tip:./$file" || die "no such file at $tip: $file"
type=$(git cat-file -t "$tip:./$file") || exit
test "$type" = blob || die "not a file ($type): $file"
empty_tree=$(git hash-object -t tree /dev/null) || exit
stat=$(git diff --numstat --no-renames "$empty_tree" "$tip" -- "$file") ||
	exit
tab=$(printf '\t')
nlines=${stat%%"$tab"*}
test "$nlines" != - || die "binary file, no lines to measure: $file"
nlines=${nlines:-0}

if test "$lines" = max
then
	start=1
	end=$nlines
else
	case $lines in
	*,*)
		start=${lines%%,*}
		end=${lines#*,}
		;;
	*)
		start=$lines
		end=$lines
		;;
	esac
	case $start$end in
	*[!0-9]*)
		die "only numeric line numbers are supported: '$lines'"
		;;
	esac
	test -n "$start" && test -n "$end" || die "bad range '$spec'
$usage"
	# As "git log -L" does: reversed endpoints are swapped and an end
	# past the end of the file is clamped.
	if test "$start" -gt "$end"
	then
		swap=$start
		start=$end
		end=$swap
	fi
	test "$start" -ge 1 || die "line numbers start at 1: '$lines'"
	test "$start" -le "$nlines" || die "file $file has only $nlines lines"
	test "$end" -le "$nlines" || end=$nlines
fi

if test "$count" = 0 || test "$start" -gt "$end"
then
	echo 0
	exit 0
fi

max=0

has () {
	case $strategy in
	*,"$1",*) return 0 ;;
	esac
	return 1
}

# Grouped ranges bound their lines only if history has no merges to walk.
single_parent=
if test -n "$first_parent" ||
	test "$(git rev-list --count --merges "$range")" = 0
then
	single_parent=1
fi

# Number of commits "git log -L" reports for any of the lines $1 to $2.
union () {
	# Assigning from $(...) keeps git's exit status, unlike a pipeline.
	commits=$(git log -L"$1,$2:$file" --format=%H --no-patch \
		$first_parent "$range") || return
	if test -n "$ignored" && test -n "$commits"
	then
		# awk reads the file itself: a long list does not fit in the
		# environment, and its status must not be lost.
		commits=$(printf '%s\n' "$commits" | awk '
			FILENAME == ARGV[1] {
				sub(/#.*/, "")
				gsub(/[ \t]+/, "")
				if ($0 != "")
					skip[$0] = 1
				next
			}
			!($0 in skip)' "$ignore_file" -) || return
	fi
	if test -z "$commits"
	then
		echo 0
	else
		printf '%s\n' "$commits" | wc -l | tr -d ' '
	fi
}

# Number of commits "git log -L" reports for line $1, stopping after $2.
capped () {
	git log -n "$2" -L"$1,$1:$file" --format=%H --no-patch \
		$first_parent "$range" | wc -l | tr -d ' '
}

# Raise $max to the depth of line $1, if it exceeds it.
leaf () {
	if has cap && test -z "$ignored" && test "$max" -gt 0
	then
		# At most $max commits means the log ended: it cannot win.
		n=$(capped "$1" $((max + 1))) || exit
		test "$n" -gt "$max" || return 0
	fi
	u=$(union "$1" "$1") || exit
	test "$u" -le "$max" || max=$u
}

# Raise $max to the largest depth among lines $1 to $2, if it exceeds it.
search () {
	has sat && test "$max" -ge "$count" && return 0
	if test "$1" -eq "$2"
	then
		leaf "$1"
		return
	fi
	if has group && test -n "$single_parent"
	then
		# With one parent per step, a line's commits are among those
		# of any range holding it.
		u=$(union "$1" "$2") || exit
		test "$u" -gt "$max" || return 0
	fi
	search "$1" $((($1 + $2) / 2)) &&
	search $((($1 + $2) / 2 + 1)) "$2"
}

if test -n "$fast"
then
	# A line neither added nor modified between X and Y has depth 0, unless
	# it was changed and then restored inside the range, which this misses.
	# Search each changed hunk of the file, as it is on the new side.  Use
	# the diff "git log -L" uses (plain Myers, no indent heuristic) rather
	# than the configured one: where equal lines are repeated, diffs differ
	# in which of them they call added, and only -L's pick is tracked.
	hunks=$(git diff -U0 --no-color --no-ext-diff --no-renames \
		--diff-algorithm=myers --no-indent-heuristic \
		"$left" "$tip" -- "$file") || exit
	ranges=$(printf '%s\n' "$hunks" | awk -v s="$start" -v e="$end" '
		/^@@ / {
			plus = $3
			sub(/^\+/, "", plus)
			n = split(plus, p, ",")
			count = (n > 1) ? p[2] : 1
			lo = p[1]
			hi = p[1] + count - 1
			if (lo < s) lo = s
			if (hi > e) hi = e
			if (count > 0 && lo <= hi)
				print lo, hi
		}')
	set -- $ranges
	while test $# -ge 2
	do
		search "$1" "$2"
		shift 2
	done
else
	search "$start" "$end"
fi

echo "$max"
