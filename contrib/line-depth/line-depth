#!/bin/sh
#
# Print the largest number of distinct commits in <rev-range> that touch any
# one line of <file> in the range <start>[,<end>], as "git log -L" tracks
# each line back from the tip of the range.
#
# Line numbers refer to <file> at the tip of <rev-range>.  Only lines that
# exist there are measured; deleted lines are not covered.

usage="usage: line-depth <rev-range> <start>[,<end>]:<file>"

die () {
	echo "line-depth: $*" >&2
	exit 1
}

test $# = 2 || {
	echo "$usage" >&2
	exit 129
}

range=$1
spec=$2
lines=${spec%%:*}
file=${spec#*:}
test "$lines" != "$spec" && test -n "$file" || die "bad range '$spec'; $usage"

tip=${range#*..}
tip=${tip#.}
tip=${tip:-HEAD}

if test "$lines" = max
then
	# Every line of the file at the tip.  Git already knows how many that
	# is: --numstat against the empty tree counts added lines (including an
	# unterminated last one) and reports binary content as "-".
	GIT_LITERAL_PATHSPECS=1
	export GIT_LITERAL_PATHSPECS
	git cat-file -e "$tip:./$file" || die "no such file at $tip: $file"
	empty_tree=$(git hash-object -t tree /dev/null) || exit
	stat=$(git diff --numstat --no-renames "$empty_tree" "$tip" -- "$file") ||
		exit
	n=${stat%%	*}
	test "$n" != - || die "binary file, no lines to measure: $file"
	start=1
	end=${n:-0}
else
	case $lines in
	*,*)
		start=${lines%%,*}
		end=${lines#*,}
		;;
	*)
		start=$lines
		end=$lines
		;;
	esac
	case $start$end in
	*[!0-9]*)
		die "only numeric line numbers are supported: '$lines'"
		;;
	esac
	test -n "$start" && test -n "$end" || die "bad range '$spec'; $usage"
	test "$start" -ge 1 || die "line numbers start at 1: '$lines'"
fi

# "git log -L" refuses a revision set that is empty because X and Y name the
# same commit, so recognize the empty set here -- but only after checking that
# the revisions, path and lines are valid at the tip of the range.
count=$(git rev-list --count "$range") || exit
if test "$count" = 0
then
	if test "$start" -le "$end"
	then
		git log -L"$start,$end:$file" -n1 --format= --no-patch "$tip" \
			>/dev/null || exit
	fi
	echo 0
	exit 0
fi

max=0
i=$start
while test "$i" -le "$end"
do
	# Assigning from $(...) keeps git's exit status, unlike a pipeline.
	commits=$(git log -L"$i,$i:$file" --format=%H --no-patch "$range") ||
		exit
	if test -n "$commits"
	then
		n=$(printf '%s\n' "$commits" | sort -u | wc -l)
		n=$((n + 0))
		test "$n" -gt "$max" && max=$n
	fi
	i=$((i + 1))
done

echo "$max"
