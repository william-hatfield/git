#!/bin/sh
#
# Follow the lines of X forward and count those that did not survive to Y.
#
#   forward-survival <X..Y> [<path>...]
#
# "git blame --reverse X..Y" walks history forward: for each line of a file at
# X it names the last revision in which that line still existed.  For the files
# that the range modifies, deletes or renames, this prints, one "key value"
# pair per line:
#
#   files           files examined
#   lines           lines those files had at X
#   removed         lines that were gone by Y
#   removal_points  distinct revisions that were the last to hold a removed
#                   line (the removal happened in a child of each)
#
# Added lines are not counted.  Compare touch-footprint, which counts the same
# lines from the diff and adds who last touched them.

usage="usage: forward-survival [--jobs=<n>] <X..Y> [<path>...]"

die () {
	echo "forward-survival: $*" >&2
	exit 1
}

jobs=1
while test $# -gt 0
do
	case $1 in
	--jobs=*)
		jobs=${1#*=}
		;;
	-*)
		echo "$usage" >&2
		exit 129
		;;
	*)
		break
		;;
	esac
	shift
done

case $jobs in
'' | *[!0-9]* | 0)
	die "--jobs needs a positive number"
	;;
esac

test $# -ge 1 || {
	echo "$usage" >&2
	exit 129
}

range=$1
shift

case $range in
*...*)
	die "needs an X..Y range, not '$range' (use the merge base as X)"
	;;
*..*)
	left=${range%%..*}
	tip=${range#*..}
	left=${left:-HEAD}
	tip=${tip:-HEAD}
	;;
*)
	die "needs an X..Y range, not '$range' (use the merge base as X)"
	;;
esac

GIT_LITERAL_PATHSPECS=1
export GIT_LITERAL_PATHSPECS

git rev-parse --verify -q "$left^{commit}" >/dev/null || die "bad revision '$left'"
tipsha=$(git rev-parse --verify -q "$tip^{commit}") || die "bad revision '$tip'"

# Work from the top of the work tree, where the paths git reports are valid;
# paths given on the command line are relative to where we were started.
prefix=$(git rev-parse --show-prefix) || exit
cdup=$(git rev-parse --show-cdup) || exit
test -z "$cdup" || cd "$cdup" || exit
for p
do
	set -- "$@" "$prefix$p"
	shift
done

changes=$(git -c core.quotePath=false diff --name-status -M \
	--ignore-submodules=all --diff-filter=MDR "$left" "$tip" -- "$@") || exit
case $changes in
*\"*)
	die "paths needing quotes are not supported"
	;;
esac

tab=$(printf '\t')

# The blame runs are queued in a temporary directory and run through xargs,
# --jobs of them at a time (see touch-footprint for the measurements).
tmp=$(mktemp -d "${TMPDIR:-/tmp}/forward-survival.XXXXXX") || exit
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' HUP INT TERM
files=0

while IFS=$tab read -r status old new
do
	test -n "$status" || continue
	files=$((files + 1))
	printf '%s' "$old" >"$tmp/$files.path"
done <<EOF
$changes
EOF

if test "$files" -gt 0
then
	FS_DIR=$tmp
	FS_RANGE="$left..$tip"
	export FS_DIR FS_RANGE
	awk -v n="$files" 'BEGIN { for (i = 1; i <= n; i++) print i }' |
	xargs -n 1 -P "$jobs" sh -c '
		git blame --reverse --porcelain "$FS_RANGE" \
			-- "$(cat "$FS_DIR/$0.path")" >"$FS_DIR/$0.out"' ||
	die "blame failed"
fi

# One output line per blamed line: the last revision that held it.
records=$(find "$tmp" -name '*.out' -exec cat {} + | awk '
	substr($0, 1, 1) == "\t" { print sha; next }
	NF >= 3 && length($1) == 40 && $1 ~ /^[0-9a-f]+$/ && $2 ~ /^[0-9]+$/ {
		sha = $1
	}')

printf '%s\n' "$records" | awk -v files="$files" -v tip="$tipsha" '
	NF {
		lines++
		if ($1 != tip) {
			removed++
			points[$1] = 1
		}
	}
	END {
		n = 0
		for (p in points)
			n++
		print "files " files
		print "lines " lines + 0
		print "removed " removed + 0
		print "removal_points " n
	}'
