#!/bin/sh
#
# Compare the work done by the commits of a range with the change it makes.
#
#   churn-ratio <X..Y> [<path>...]
#
# Output, one "key value" pair per line:
#
#   gross    lines added plus deleted, summed over the commits of X..Y
#   net      lines added plus deleted by the single diff of X against Y
#   rework   gross minus net (0 if net is larger): lines that were changed
#            and then changed again, or changed and restored
#
# Merge commits show no changes of their own in "git log --numstat" and so
# add nothing to gross; binary files are skipped.  gross/net is the ratio.

usage="usage: churn-ratio <X..Y> [<path>...]"

die () {
	echo "churn-ratio: $*" >&2
	exit 1
}

test $# -ge 1 || {
	echo "$usage" >&2
	exit 129
}

range=$1
shift

case $range in
*...*)
	die "needs an X..Y range, not '$range' (use the merge base as X)"
	;;
*..*)
	left=${range%%..*}
	tip=${range#*..}
	left=${left:-HEAD}
	tip=${tip:-HEAD}
	;;
*)
	die "needs an X..Y range, not '$range' (use the merge base as X)"
	;;
esac

GIT_LITERAL_PATHSPECS=1
export GIT_LITERAL_PATHSPECS

git rev-parse --verify -q "$left^{commit}" >/dev/null || die "bad revision '$left'"
git rev-parse --verify -q "$tip^{commit}" >/dev/null || die "bad revision '$tip'"

# Assigning from $(...) keeps git's exit status, unlike a pipeline.
gross_stat=$(git log --numstat --ignore-submodules=all --format= "$range" \
	-- "$@") || exit
net_stat=$(git diff --numstat --ignore-submodules=all "$left" "$tip" \
	-- "$@") || exit

# Lines added plus deleted; binary files report "-" and are skipped.
sum () {
	printf '%s\n' "$1" | awk '$1 != "-" { n += $1 + $2 } END { print n + 0 }'
}

gross=$(sum "$gross_stat")
net=$(sum "$net_stat")
rework=$((gross - net))
test "$rework" -ge 0 || rework=0

echo "gross $gross"
echo "net $net"
echo "rework $rework"
